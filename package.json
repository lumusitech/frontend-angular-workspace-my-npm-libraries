{
  "name": "lumusitech-workspace",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumusitech/frontend-angular-workspace-my-npm-libraries"
  },
  "keywords": [
    "Luciano",
